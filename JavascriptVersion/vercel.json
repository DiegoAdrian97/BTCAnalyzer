{
  "git": {
    "deploymentEnabled": {
      "historial": false,
      "medicion-monedas": false
    }
  },
  "regions": [
    "fra1"
  ],
  "functions": {
    "api/siri.js": {
      "maxDuration": 30,
      "includeFiles": "{indicadores.js,aprendizaje.js,fuerte.js,analisis.js,datos.js,termometro.json,modelo_fuerte.json}"
    }
  },
  "headers": [
    {
      "source": "/lib/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/p-(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(app|worker|analisis|datos|indicadores|aprendizaje|fuerte).js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/icono-(.*).png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        }
      ]
    }
  ]
}
